# ─────────────────────────────────────────────────────────────
# COURTSCAPE environment variables. Copy to .env.local for development.
# Never commit real secrets. NEXT_PUBLIC_* values are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@courtscape.example
NEXT_PUBLIC_PARTNERS_EMAIL=partners@courtscape.example
# Set to "false" on preview/staging deployments to block indexing
ALLOW_INDEXING=true

# Database (Supabase Postgres). Use the *pooled* connection string (port 6543, transaction mode).
# If unset, a local JSON store at .data/courtscape.json is used (development/demo only).
DATABASE_URL=
DATABASE_POOL_MAX=5
LOCAL_DATA_FILE=

# Supabase (Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never expose
SUPABASE_PRIVATE_BUCKET=guides-private
SUPABASE_PUBLIC_BUCKET=media

# Admin authentication
# "supabase" (recommended in production) or "password" (simple single-editor setup)
ADMIN_AUTH_PROVIDER=password
ADMIN_EMAILS=editor@courtscape.example   # comma-separated allowlist
ADMIN_PASSWORD=                          # password mode only — use a long random value
ADMIN_SESSION_SECRET=                    # ≥ 32 random characters: openssl rand -base64 48

# Payments: "test" (default sandbox — no money moves) or "stripe"
PAYMENT_PROVIDER=test
ALLOW_TEST_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOWNLOAD_TTL_DAYS=30
MAX_DOWNLOADS=10

# Maps (optional — falls back to OpenStreetMap tiles for development)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Analytics & Search Console (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Social (optional)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=
