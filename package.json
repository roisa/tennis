{
  "name": "courtscape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "rm -rf out && STATIC_EXPORT=1 NEXT_PUBLIC_BASE_PATH=${PAGES_BASE_PATH:-/tennis} NEXT_PUBLIC_SITE_URL=${PAGES_SITE_URL:-https://roisa.github.io/tennis} LOCAL_DATA_FILE=.data/pages-build.json next build && touch out/.nojekyll",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed-sql": "tsx scripts/generate-seed-sql.ts",
    "db:reset-local": "tsx scripts/db-reset-local.ts",
    "pdfs:placeholder": "tsx scripts/make-placeholder-pdfs.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.5",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
